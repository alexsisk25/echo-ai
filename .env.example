# Copy this file to .env and fill in your own keys. .env is gitignored
# and must never be committed.

# Anthropic API key for cloud summaries, dossiers, translation, and Ask.
# Get one at https://console.anthropic.com. Only meeting text is ever
# sent; audio never leaves your Mac, and recordings you mark privileged
# are analyzed entirely by a local model instead.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# HuggingFace token for the gated speaker-diarization models.
# Create a read token at https://huggingface.co/settings/tokens, then
# accept the terms on BOTH model pages:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_your-token-here

# Optional overrides (defaults shown; uncomment to change):
# OTTER_LLM_MODEL=anthropic/claude-haiku-4-5
# OTTER_LOCAL_LLM_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
# OTTER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OTTER_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# OTTER_CALENDAR_PROVIDER=auto
# OTTER_PORT=8000
